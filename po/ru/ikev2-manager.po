msgstr "Ручная входящая конфигурация загружена."

msgid "Custom mode replaces the generated inbound connection and pool blocks. Normal form values remain stored but do not change the active strongSwan profile until generated mode is restored."
msgstr "Ручной режим заменяет сгенерированное входящее подключение и блоки пулов. Значения формы сохраняются, но не меняют активный профиль strongSwan до возврата в сгенерированный режим."

msgid "Custom mode replaces the generated outbound connection. Credentials remain managed separately by the EAP fields above."
msgstr "Ручной режим заменяет сгенерированное исходящее подключение. Учетные данные по-прежнему управляются EAP-полями выше."

msgid "Custom outbound configuration loaded."
msgstr "Ручная исходящая конфигурация загружена."

msgid "Custom profile loaded."
msgstr "Пользовательский профиль загружен."

msgid "Custom service deleted and policy rebuilt."
msgstr "Пользовательский сервис удалён, политика пересобрана."

msgid "Custom services"
msgstr "Мои сервисы"

msgid "Custom…"
msgstr "Своё значение…"

msgid "DNS apply did not start"
