msgstr "Каталог ACME-сертификата"

msgid "ACME settings rejected"
msgstr "Настройки ACME отклонены"

msgid "ACME settings saved."
msgstr "Настройки ACME сохранены."

msgid "Acceleration for ordinary WAN traffic; policy-routed traffic remains under VPN control."
msgstr "Ускорение обычного WAN-трафика; трафик по правилам маршрутизации остаётся под контролем VPN."

