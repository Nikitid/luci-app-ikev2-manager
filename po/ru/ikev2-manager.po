msgstr "Весь IPv4-трафик (полный туннель)"

msgid "All default network segments still use domain routing. Add a rule below only when a device needs different behavior."
msgstr "Все базовые сетевые сегменты используют доменную маршрутизацию. Добавляйте правило ниже только если устройству нужен другой режим."

msgid "All devices use the default routing, DNS and Zapret policies."
msgstr "Все устройства используют стандартные политики маршрутизации, DNS и Zapret."

msgid "All local networks"
msgstr "Все локальные сети"

msgid "All names now resolve through the tunnel."
msgstr "Все имена теперь резолвятся через туннель."

msgid "All required components must pass before managed routing can be enabled."
msgstr "Все обязательные компоненты должны пройти проверку перед включением управляемой маршрутизации."

msgid "All runtime dependencies installed."
msgstr "Все зависимости установлены."

msgid "All sessions disconnected."
msgstr "Все сессии отключены."

