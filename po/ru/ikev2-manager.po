msgid "Additional TCP/UDP ports remain available when router access is denied. Use spaces or commas between ports and ranges."
msgstr "Дополнительные TCP/UDP-порты остаются доступными, когда доступ к роутеру запрещён. Разделяйте порты и диапазоны пробелами или запятыми."

msgid "Address / subnet"
msgstr "Адрес / подсеть"

msgid "Address unavailable"
msgstr "Адрес недоступен"

msgid "Adds the resolvers published by the WAN provider to the fallback group above. They are not a further tier: the group is used as a whole once the primary group fails, and the provider entries are selected on equal terms with the ones you configured."
msgstr "Добавляет резолверы, полученные от провайдера, в резервную группу выше. Это не отдельная ступень: группа используется целиком при отказе основной, и записи провайдера выбираются наравне с заданными вами."

msgid "Advanced access settings"
msgstr "Расширенные настройки доступа"

msgid "Advanced certificate settings"
msgstr "Расширенные настройки сертификата"

msgid "Advanced connection settings"
msgstr "Расширенные настройки подключения"

