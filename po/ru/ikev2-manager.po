msgstr "Архитектура"

msgid "Automatic"
msgstr "Автоматически"

msgid "Automatic from identity"
msgstr "Автоматически по имени сервера"

msgid "Available after runtime dependencies are installed."
msgstr "Станет доступно после установки системных компонентов."

msgid "Available after the runtime check succeeds."
msgstr "Доступно после успешной проверки системных компонентов."

msgid "Available memory"
msgstr "Доступная оперативная память"

msgid "Avoids oversized IKE packets on constrained networks."
msgstr "Предотвращает проблемы с крупными IKE-пакетами в сетях с ограничениями."

msgid "Base routing and firewall configuration applied."
msgstr "Базовые правила маршрутизации и межсетевого экрана применены."

msgid "Block DNS-over-TLS"
msgstr "Блокировать DNS-over-TLS"

msgid "Blocked services may stop opening for these devices."
msgstr "На этих устройствах могут перестать открываться заблокированные сервисы."

msgid "Bootstrap DNS"
msgstr "Bootstrap DNS"

msgid "Bootstrap DNS must contain IPv4:port entries"
msgstr "Bootstrap DNS должен содержать адреса в формате IPv4:порт"

msgid "Bootstrap DNS must contain IPv4:port entries or DoH/DoT/DoQ endpoints with a literal IPv4 address"
msgstr "Bootstrap DNS должен содержать записи вида IPv4:порт либо адреса DoH/DoT/DoQ с числовым IPv4"

msgid "Broad — may also route unrelated sites"
msgstr "Широкий — может вести и посторонние сайты"

msgid "Browser compatibility"
msgstr "Совместимость браузеров"

msgid "Build the IPv4 VPN policy from curated services, custom destinations and per-device modes."
msgstr "Собирает IPv4 VPN-политику из готовых сервисов, собственных направлений и режимов устройств."

msgid "Building the combined policy list..."
msgstr "Собираю общий список маршрутизации..."

msgid "Built into the package"
msgstr "Встроенный в пакет"

msgid "Bypass Zapret processing"
msgstr "Не обрабатывать через Zapret"

msgid "CHILD rekey"
msgstr "CHILD rekey"

msgid "Cancel"
msgstr "Отмена"

msgid "Capture a short, separate strongSwan trace while the affected client tries to connect. The capture stops automatically and does not increase system-log verbosity."
msgstr "Запишите отдельную короткую трассировку strongSwan во время попытки подключения проблемного клиента. Сбор остановится автоматически и не увеличит подробность системного журнала."

msgid "Capture completed."
msgstr "Сбор завершён."

msgid "Capture debug log for 60 seconds"
msgstr "Собирать отладочный журнал 60 секунд"

msgid "Capture failed."
msgstr "Не удалось собрать диагностику."

msgid "Capture for 60 seconds"
msgstr "Записать 60 секунд"

msgid "Capturing FakeIP diagnostics..."
msgstr "Собираю диагностику FakeIP..."

msgid "Capturing inbound IKE attempts..."
msgstr "Записываю входящие попытки IKE..."

msgid "Certificate"
msgstr "Сертификат"

msgid "Certificate file override"
msgstr "Путь к сертификату вручную"

msgid "Certificate identity expected from the VPS."
msgstr "Ожидаемая идентичность сертификата VPS."

msgid "Certificate issued."
msgstr "Сертификат выпущен."

msgid "Certificate issuer"
msgstr "Издатель сертификата"

msgid "Certificate paths"
msgstr "Пути сертификатов"

msgid "Certificate present"
msgstr "Сертификат действует"

msgid "Certificate request did not start."
msgstr "Не удалось запустить запрос сертификата."

msgid "Certificate request failed."
msgstr "Не удалось выпустить сертификат."

msgid "Certificate subject"
msgstr "Имя владельца сертификата"

msgid "Challenge method"
msgstr "Метод проверки"

msgid "Change"
msgstr "Изменить"

msgid "Change password"
msgstr "Сменить пароль"

msgid "Changing these values interrupts routed domains for a few seconds while the tunnel and PBR restart."
msgstr "При изменении этих значений выбранные домены могут быть недоступны несколько секунд, пока перезапускаются туннель и PBR."

msgid "Changing these values reloads the tunnel profile and reconnects it. Policy routing stays in place."
msgstr "Изменение этих значений перезагружает профиль туннеля и переподключает его. Маршрутизация остаётся на месте."

msgid "Check"
msgstr "Проверить"

msgid "Check unavailable"
msgstr "Проверка недоступна"

msgid "Choose a detected ACME name or enter another DNS name."
msgstr "Выберите обнаруженное имя ACME или укажите другое DNS-имя."

msgid "Choose a service to inspect or edit, or start a new one."
msgstr "Выберите сервис для просмотра или изменения либо создайте новый."

msgid "Choose global defaults for inbound clients. Individual overrides are configured on the Users page."
msgstr "Задайте глобальные правила для входящих клиентов. Индивидуальные исключения настраиваются на странице «VPN-пользователи»."

msgid "Choose how the router resolves public DNS names. dnsmasq-full remains the local resolver and continues populating PBR nftsets."
msgstr "Выберите, как роутер разрешает публичные DNS-имена. dnsmasq-full остаётся локальным резолвером и продолжает наполнять nftset для PBR."

msgid "Choose the WAN uplink and the networks this app protects. Firewall zones are detected automatically."
msgstr "Выберите подключение к интернету и сети, для которых приложение управляет маршрутизацией. Зоны межсетевого экрана определяются автоматически."

msgid "Choose the public DNS upstream. In reliable mode dnsmasq sends public queries through sing-box, which uses dnsproxy as its upstream; in standard mode dnsmasq uses dnsproxy directly."
msgstr "Выберите внешний DNS-сервер. В надёжном режиме dnsmasq передаёт публичные запросы в sing-box, который использует dnsproxy как upstream; в обычном режиме dnsmasq обращается к dnsproxy напрямую."

msgid "Choose what clients send through IKEv2 and where that traffic may go."
msgstr "Выберите, какой трафик клиенты отправляют в IKEv2 и куда ему разрешён доступ."

msgid "Choose which clients participate in domain routing or override it completely."
msgstr "Выберите клиентов, участвующих в доменной маршрутизации, или задайте им отдельный режим."

msgid "Client IPv4 pool"
msgstr "IPv4-пул клиентов"

msgid "Client profile for %s"
msgstr "Профиль клиента %s"

msgid "Client profiles"
msgstr "Профили клиента"

msgid "Client queries currently resolve through the tunnel and do not use this resolver. It still resolves names for the router's own direct connections, and destination segments keep working independently."
msgstr "Клиентские запросы сейчас резолвятся через туннель и этот резолвер не используют. Он по-прежнему резолвит имена для прямых соединений самого роутера, а сегменты назначения работают независимо."

msgid "Client routes and access"
msgstr "Маршруты и доступ клиентов"

msgid "Close"
msgstr "Закрыть"

msgid "Community list"
msgstr "Список сообщества"

msgid "Community services"
msgstr "Готовые сервисы"

msgid "Complete TCP/UDP allowlist used when all ports are off. Keep LuCI and SSH ports in this list or inbound VPN management access will stop."
msgstr "Полный белый список TCP/UDP, используемый когда разрешение всех портов выключено. Оставьте здесь порты LuCI и SSH, иначе управление через входящий VPN перестанет работать."

msgid "Components installed specifically for IKEv2, PBR and reliable domain routing."
msgstr "Компоненты, устанавливаемые специально для IKEv2, PBR и надёжной доменной маршрутизации."

msgid "Components that OpenWrt or other apps may also use. Reset removes them only when this app installed them and no other package still needs them."
msgstr "Компоненты, которые также могут использовать OpenWrt и другие приложения. Сброс удаляет их, только если они установлены этим приложением и больше не нужны другим пакетам."

msgid "Configuration"
msgstr "Конфигурация"

msgid "Configuration applied."
msgstr "Конфигурация применена."

msgid "Configure the public identity, client pool and certificate used by remote devices."
msgstr "Настройте публичное имя сервера, пул адресов и сертификат для удалённых устройств."

msgid "Configure the server identity and client address pool. Less common settings are grouped below."
msgstr "Настройте имя сервера и пул адресов клиентов. Остальные параметры сгруппированы ниже."

msgid "Configured"
msgstr "Настроено"

msgid "Connected"
msgstr "Подключено"

msgid "Connected device"
msgstr "Подключённое устройство"

msgid "Connection"
msgstr "Подключение"

