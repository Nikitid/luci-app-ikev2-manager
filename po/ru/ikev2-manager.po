msgstr "Собираю диагностику FakeIP..."

msgid "Capturing inbound IKE attempts..."
msgstr "Записываю входящие попытки IKE..."

msgid "Certificate"
msgstr "Сертификат"

msgid "Certificate file override"
msgstr "Путь к сертификату вручную"

msgid "Certificate identity expected from the VPS."
msgstr "Ожидаемая идентичность сертификата VPS."

msgid "Certificate issued."
msgstr "Сертификат выпущен."

msgid "Certificate issuer"
msgstr "Издатель сертификата"

msgid "Certificate paths"
msgstr "Пути сертификатов"

msgid "Certificate present"
msgstr "Сертификат действует"

msgid "Certificate request did not start."
msgstr "Не удалось запустить запрос сертификата."

msgid "Certificate request failed."
msgstr "Не удалось выпустить сертификат."

msgid "Certificate subject"
msgstr "Имя владельца сертификата"

msgid "Challenge method"
msgstr "Метод проверки"

