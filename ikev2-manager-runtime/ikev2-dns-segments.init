#!/bin/sh /etc/rc.common

START=90
STOP=4
USE_PROCD=1

# The resolvers the provider handed to the WAN interface, as plain DNS
# endpoints. Recorded in $wan_dns_file so the health watcher can restart the
# segments that use them when the lease brings different ones.
wan_dns_file=/var/run/ikev2-dns-segments.wan

wan_dns_endpoints() {
	local interface address result=''
	interface="$(uci -q get ikev2-manager.globals.wan_interface || echo wan)"
	for address in $(ubus call "network.interface.$interface" status 2>/dev/null |
		jsonfilter -e '@["dns-server"][*]' 2>/dev/null); do
		case "$address" in
			*[!0-9.]* | '') continue ;;
			0.* | 127.* | 169.254.* | 22[4-9].* | 23[0-9].* | 24[0-9].* | 25[0-5].*) continue ;;
		esac
		result="${result:+$result }udp://$address:53"
	done
	printf '%s\n' "$result"
}

start_segment() {
	local section="$1" enabled port protocol mode upstream bootstrap fallback endpoint binary inherited seen duplicate wan_fallback
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get port "$section" port
	config_get protocol "$section" protocol
	config_get mode "$section" upstream_mode load_balance
	config_get upstream "$section" upstream
	config_get bootstrap "$section" bootstrap
	config_get fallback "$section" fallback
	# An empty segment fallback inherits both global groups. Existing
	# configurations therefore gain an independent recovery path on upgrade.
	if [ -z "$fallback" ]; then
		inherited="$(uci -q get dnsproxy.servers.fallback 2>/dev/null) \
$(uci -q get ikev2-manager.dns.upstream 2>/dev/null)"
		fallback=''
		for endpoint in $inherited; do
			duplicate=0
			for seen in $upstream $fallback; do
				[ "$seen" != "$endpoint" ] || { duplicate=1; break; }
			done
			[ "$duplicate" = 0 ] || continue
			fallback="${fallback:+$fallback }$endpoint"
		done
	fi
	# The provider's resolvers come last: plain DNS, used only when every
	# other server of the segment has failed.
	config_get_bool wan_fallback "$section" wan_fallback 0
	[ "$wan_fallback" = 0 ] || fallback="$fallback $wan_endpoints"
	inherited=''
	for endpoint in $fallback; do
		duplicate=0
		for seen in $upstream $inherited; do
			[ "$seen" != "$endpoint" ] || { duplicate=1; break; }
		done
		[ "$duplicate" = 0 ] || continue
		inherited="${inherited:+$inherited }$endpoint"
	done
	fallback="$inherited"
	case "$port" in '' | *[!0-9]*) return 1 ;; esac
	[ "$port" -ge 5550 ] && [ "$port" -le 5599 ] || return 1
	case "$mode" in load_balance | parallel | fastest_addr) ;; *) return 1 ;; esac
	[ -n "$upstream" ] || return 1
	binary="$(command -v dnsproxy)" || return 1

	procd_open_instance "$section"
	procd_set_param command "$binary" -l 127.0.0.1 -p "$port" \
		--upstream-mode "$mode" --timeout 3s
	[ "$protocol" != doh3 ] || procd_append_param command --http3
	for endpoint in $upstream; do
		procd_append_param command -u "$endpoint"
	done
	for endpoint in $bootstrap; do
		procd_append_param command -b "$endpoint"
	done
	for endpoint in $fallback; do
		procd_append_param command -f "$endpoint"
	done
	procd_set_param user dnsproxy
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	[ "$(uci -q get ikev2-manager.globals.configured)" = 1 ] || return 0
	[ "$(uci -q get ikev2-manager.dns.managed)" = 1 ] || return 0
	config_load ikev2-manager
	wan_endpoints="$(wan_dns_endpoints)"
	printf '%s\n' "$wan_endpoints" >"$wan_dns_file"
	config_foreach start_segment dns_segment
}

service_triggers() {
	procd_add_reload_trigger ikev2-manager
}
