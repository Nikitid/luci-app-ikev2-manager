#!/bin/sh

[ "$(uci -q get ikev2-manager.globals.configured)" = 1 ] || exit 0
wan_interface="$(uci -q get ikev2-manager.globals.wan_interface || echo wan)"
[ "$INTERFACE" = "$wan_interface" ] || exit 0

# Restore the tunnel interface, its address and route at once. Reconnecting the
# client and refreshing provider resolvers are not repeated here: charon retries
# initiation itself, and ikev2-health runs ensure-client and the WAN resolver
# refresh on its own schedule.
case "$ACTION" in
	ifup | ifupdate)
		/etc/init.d/ikev2-xfrm start
		/usr/libexec/ikev2-sync-vips || true
		/usr/libexec/ikev2-routing sync-all || true
		;;
esac
