#!/bin/sh /etc/rc.common

START=97
STOP=03
USE_PROCD=1

# The services board runs only where it was turned on.
start_service() {
	[ "$(uci -q get ikev2-manager.board.enabled)" = 1 ] || return 0
	procd_open_instance board
	procd_set_param command /usr/libexec/ikev2-board serve
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ikev2-manager
}
