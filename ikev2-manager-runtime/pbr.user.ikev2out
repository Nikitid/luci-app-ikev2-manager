#!/bin/sh

# PBR includes this file. Releases that routed through PBR registered it as an
# include, and a router keeps that registration until its next Apply retires
# the application's PBR policies; PBR would fail to start if the file were
# gone. It maintains nothing of PBR's any more: it syncs the application's own
# routing, as every PBR reload did before.

ikev2_pbr_main() {
[ "$(uci -q get ikev2-manager.globals.configured)" = 1 ] || return 0
[ ! -x /usr/libexec/ikev2-routing ] || /usr/libexec/ikev2-routing sync-all >/dev/null 2>&1
}

# PBR sources this include, while older call sites also execute it directly.
# Keeping all returns inside a function makes both modes valid.
ikev2_pbr_main "$@"
