#!/bin/sh /etc/rc.common
# Start only after explicit initialization; stopping retains the denial table.
START=88
STOP=90
USE_PROCD=1

start_service() {
 local api_settings api_certificate api_key
	[ -f /etc/ikev2-manager/clients/initialized ] || return 0
	[ -x /usr/libexec/ikev2-client-access ] || return 0
	procd_open_instance access
	procd_set_param command /usr/libexec/ikev2-client-access watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance catalog
	procd_set_param command /usr/libexec/ikev2-client-catalog watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance enrollment
	procd_set_param command /usr/libexec/ikev2-client-enrollment watch
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
 if [ "$(uci -q get ikev2-manager.client_access.enabled)" = 1 ]; then
  procd_open_instance api
  procd_set_param command /usr/libexec/ikev2-client-api serve
  api_settings="$(/usr/bin/ucode /usr/libexec/ikev2-manager.d/client-api-settings.uc 2>/dev/null)" || api_settings=''
  api_certificate="$(printf '%s' "$api_settings" | jsonfilter -e '@.certificate' 2>/dev/null)" || api_certificate=''
  api_key="$(printf '%s' "$api_settings" | jsonfilter -e '@.private_key' 2>/dev/null)" || api_key=''
  if [ -n "$api_certificate" ] && [ -n "$api_key" ]; then
   procd_set_param file /etc/config/ikev2-manager "$api_certificate" "$api_key"
  else procd_set_param file /etc/config/ikev2-manager; fi
  procd_set_param respawn 3600 5 5
  procd_set_param term_timeout 10
  procd_set_param stdout 0
  procd_set_param stderr 1
  procd_close_instance
 fi
}

stop_service() {
	[ -f /etc/ikev2-manager/clients/initialized ] || return 0
	/usr/libexec/ikev2-client-access close
}

service_triggers() {
 procd_add_reload_trigger ikev2-manager
}

reload_service() {
	start
}
