<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Waypoint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Waypoint">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar: the window's own, drawn over the backdrop. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Waypoint.ico" Width="16" Height="16" />
                <TextBlock Text="Waypoint" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24,12,24,12" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <!-- Status: sign, what it is, what it means. -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Top">
                            <Ellipse x:Name="Halo" Opacity="0.15" />
                            <FontIcon x:Name="Sign" FontSize="20" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="Description" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="Notice" Severity="Warning" IsClosable="False" />
                    <InfoBar x:Name="SupportNotice" Severity="Success" IsClosable="False" Message="Поддержка ответила на ваше обращение.">
                        <InfoBar.ActionButton>
                            <Button Content="Открыть" Click="OnReplies" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="ПРОВЕРКИ" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="Checks" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="СЕРВИСЫ" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="Services" Spacing="2" />
                            <TextBlock x:Name="ServicesLine" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ServicesNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AvailableLine" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- The addresses another VPN needs to leave this one alone. -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Адреса Waypoint" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Для исключений в другом VPN." Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="Addresses" Spacing="10" />
                        <TextBlock Text="Используйте домен или IP сервера." Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- What to do next on the left, the rest on the right, and under them
             when the state was last checked: the same order as on macOS. -->
        <Grid Grid.Row="2" Padding="24,8,24,14" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RegisterButton" Content="Регистрация…" Style="{StaticResource AccentButtonStyle}" Click="OnRegister" />
                <Button x:Name="ResumeButton" Content="Продолжить" Click="OnResume" />
                <Button x:Name="ConnectButton" Content="Включить" Style="{StaticResource AccentButtonStyle}" Click="OnConnect" />
                <Button x:Name="DisconnectButton" Content="Отключить" Click="OnDisconnect" />
                <Button x:Name="UpdateButton" Content="Обновить" Click="OnUpdate" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowsersButton" Content="Браузеры…" Click="OnBrowsers" />
                <Button Content="Проверить" Click="OnRefresh" />
                <Button Content="Отчёт…" Click="OnReport" />
                <DropDownButton ToolTipService.ToolTip="Тема">
                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Системная" GroupName="Theme" Click="OnTheme" Tag="system" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Светлая" GroupName="Theme" Click="OnTheme" Tag="light" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Тёмная" GroupName="Theme" Click="OnTheme" Tag="dark" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <!-- Everything the program put on this computer goes with one action. -->
                <Button Content="Сбросить…" Click="OnReset" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
            <TextBlock x:Name="CheckedLine" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
