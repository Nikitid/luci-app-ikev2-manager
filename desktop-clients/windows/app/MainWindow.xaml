<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Waypoint.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Waypoint">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Layout Б: the window's own title bar, side navigation - Overview,
         Services, own sites and addresses, Reports; the state and Settings at
         the foot. The pages are built in code from WindowModel. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="Waypoint" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="900" OpenPaneLength="264"
                        SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavOverview" Tag="overview" AutomationProperties.Name="Обзор">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavServices" Tag="services" AutomationProperties.Name="Сервисы">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavOwn" Tag="own" AutomationProperties.Name="Свои сайты и адреса">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavReports" Tag="reports" AutomationProperties.Name="Обращения">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- The state, in every section: a click opens Overview. -->
                <NavigationViewItem x:Name="NavState" Tag="state" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon x:Name="NavStateSign" Glyph="&#xE915;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="settings" Content="Параметры">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Pages fill the width up to a reading measure, set to the left. -->
                    <Grid Padding="32,20,32,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="760" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Body" HorizontalContentAlignment="Stretch" />
                    </Grid>
                </ScrollViewer>
                <!-- The one motion of its own: the content of a section changes
                     under a layer that fades out in 0.2 s. -->
                <Border x:Name="Veil" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </NavigationView>

        <!-- First run: no navigation before the answers. -->
        <ScrollViewer x:Name="Welcome" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="WelcomeBody" MaxWidth="560" Padding="32,40,32,32" />
        </ScrollViewer>

        <TeachingTip x:Name="TrayTip" Title="Waypoint в трее" PreferredPlacement="BottomRight" IsLightDismissEnabled="True"
                     Subtitle="Здесь подключение и сервисы по выбору. Окно — двойным щелчком." CloseButtonContent="Понятно" />
    </Grid>
</Window>
