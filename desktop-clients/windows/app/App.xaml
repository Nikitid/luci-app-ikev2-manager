<Application
    x:Class="Waypoint.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Patina and graphite: one patina accent in place of the system's,
                 warm paper by day and graphite at night. The norm is said in ink,
                 colour only when something is off. The values come from the
                 design tokens. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#207070</Color>
                    <Color x:Key="SystemAccentColorLight1">#488D8D</Color>
                    <Color x:Key="SystemAccentColorLight2">#67ACAC</Color>
                    <Color x:Key="SystemAccentColorLight3">#7ABFBF</Color>
                    <Color x:Key="SystemAccentColorDark1">#207070</Color>
                    <Color x:Key="SystemAccentColorDark2">#115E5E</Color>
                    <Color x:Key="SystemAccentColorDark3">#004D4D</Color>
                    <Color x:Key="ToneOpen">#1D2227</Color>
                    <Color x:Key="ToneWorking">#7B5518</Color>
                    <Color x:Key="ToneAttention">#993A31</Color>
                    <Color x:Key="ToneOff">#65696F</Color>
                    <!-- surface, line, line-strong, text-2 and danger of the tokens. -->
                    <SolidColorBrush x:Key="CardSurface" Color="#FDFDFB" />
                    <SolidColorBrush x:Key="CardEdge" Color="#D4D2CF" />
                    <SolidColorBrush x:Key="CardHighlight" Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="NotchBrush" Color="#4B5056" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#993A31" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#7B5518" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#7ABFBF</Color>
                    <Color x:Key="SystemAccentColorLight1">#7ABFBF</Color>
                    <Color x:Key="SystemAccentColorLight2">#7ABFBF</Color>
                    <Color x:Key="SystemAccentColorLight3">#84C9C8</Color>
                    <Color x:Key="SystemAccentColorDark1">#67ACAC</Color>
                    <Color x:Key="SystemAccentColorDark2">#488D8D</Color>
                    <Color x:Key="SystemAccentColorDark3">#287070</Color>
                    <Color x:Key="ToneOpen">#E8EAEC</Color>
                    <Color x:Key="ToneWorking">#E1BB74</Color>
                    <Color x:Key="ToneAttention">#ED8C80</Color>
                    <Color x:Key="ToneOff">#909499</Color>
                    <SolidColorBrush x:Key="CardSurface" Color="#232528" />
                    <SolidColorBrush x:Key="CardEdge" Color="#383B3F" />
                    <SolidColorBrush x:Key="CardHighlight" Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="NotchBrush" Color="#AEB1B6" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#ED8C80" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#E1BB74" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="CardSurface" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="CardEdge" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="CardHighlight" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="NotchBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DangerBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="WarningBrush" ResourceKey="SystemColorHighlightColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- A card: held by a hairline edge, not a shadow. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,16,18,16" />
            </Style>
            <!-- A list of rows on one card: 8 px, as Fluent beside its 4 px
                 controls; the rows stand on hairlines inside it. -->
            <Style x:Key="ListCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- Text and lines of the pages built in code. Their colours come
                 through these styles as theme resources, so they follow the
                 window's light or dark, which a brush read in code does not. -->
            <Style x:Key="SecondaryBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DangerCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="WarningCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DangerBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="WarningBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
            </Style>
            <Style x:Key="StateHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Light" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="StateHeadingAttention" TargetType="TextBlock" BasedOn="{StaticResource StateHeading}">
                <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
            </Style>
            <Style x:Key="Hairline" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardEdge}" />
            </Style>
            <Style x:Key="DangerLine" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DangerBrush}" />
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <Style x:Key="Notch" TargetType="Rectangle">
                <Setter Property="Width" Value="1.5" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Fill" Value="{ThemeResource NotchBrush}" />
            </Style>
            <Style x:Key="NotchFailed" TargetType="Rectangle">
                <Setter Property="Width" Value="2" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Fill" Value="{ThemeResource DangerBrush}" />
            </Style>
            <Style x:Key="SecondaryIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- The name of a section: plain words, not capitals. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- A name in a list: set apart by weight, never bold. -->
            <Style x:Key="Emphasis" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
