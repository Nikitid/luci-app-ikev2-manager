<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every test of the Windows client in one program on current .NET, as the
       service ships: "Waypoint.Tests <TestClass> [arguments]" runs that class's
       Main. The service itself is published next to it by test.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <AssemblyName>Waypoint.Tests</AssemblyName>
    <StartupObject>TestMain</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The sources are shared with the .NET Framework reference build. -->
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0023;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Exclude="..\Setup.cs;..\ClientService.cs;..\JsonCompatTests.cs" />
    <EmbeddedResource Include="..\ManagedVpnProfile.ps1" LogicalName="ManagedVpnProfile.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
