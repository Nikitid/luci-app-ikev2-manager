# Public OpenWrt 25.12 build and feed identity. This file is sourced as POSIX sh.

# Target this package is built for.
OPENWRT_APK_VERSION=25.12.6
OPENWRT_APK_TARGET=mediatek/filogic
OPENWRT_APK_ARCH=aarch64_cortex-a53
OPENWRT_APK_SDK_ARCHIVE=openwrt-sdk-25.12.6-mediatek-filogic_gcc-14.3.0_musl.Linux-x86_64.tar.zst
OPENWRT_APK_SDK_SHA256=1c04ac47bdfc361d6aab299eb520d570e368013dedcb8d29cf39dc7168ae642e

# Shared publisher key. The same key signs every Nikitid OpenWrt application and
# the shared index; apk binds a key to neither a package nor a repository, so a
# per-application key would only add another trust anchor to every router.
OPENWRT_APK_KEY_FILE=keys/nikitid-openwrt-release.pem
OPENWRT_APK_KEY_ALIAS=keys/ikev2-manager-release.pem
OPENWRT_APK_TRUST_SHA256=f27474d9261f1084350cf4ba34ecdff29e533769c36483d8dd85566e30a6a703

# This repository builds and signs its own package and publishes it as a GitHub
# Release asset. It no longer assembles an index: Nikitid/openwrt-feed collects
# the current release of every member application, verifies the signatures and
# publishes the signed index. Keeping the feed out of an application repository
# means renaming or retiring this project no longer moves a URL recorded in
# /etc/apk/repositories.d on every installed router.
OPENWRT_FEED_REPOSITORY=Nikitid/openwrt-feed
OPENWRT_FEED_BASE=https://raw.githubusercontent.com/Nikitid/openwrt-feed/feed
OPENWRT_FEED_URL=$OPENWRT_FEED_BASE/packages.adb
OPENWRT_FEED_LIST=/etc/apk/repositories.d/nikitid-openwrt.list
OPENWRT_IKEV2_PACKAGE=luci-app-ikev2-manager
